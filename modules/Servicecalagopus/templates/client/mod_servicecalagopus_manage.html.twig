{% if order.status == 'active' %}
{% set server = service.server|default(null) %}
<div class="card mb-4">
    <div class="card-header py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h1 class="mb-1">{{ server.name|default('Server Details'|trans) }}</h1>
                <span class="small text-secondary">
                    {% if server and server.egg %}
                        {{ server.egg }}{% if server.nest %} &middot; {{ server.nest }}{% endif %}
                    {% else %}
                        {{ 'Your game server on the control panel'|trans }}
                    {% endif %}
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                {% if server and server.state %}
                    <span class="badge {{ server.state.badge }}">{{ server.state.label }}</span>
                {% endif %}
                {% if service.panel_url is defined %}
                    <a class="btn btn-sm btn-primary" href="{{ service.panel_url }}" target="_blank" rel="noopener">{{ 'Open Panel'|trans }}</a>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="card-body">
        {% if service.error is defined %}
            <div class="alert alert-warning mb-0" role="alert">{{ service.error }}</div>
        {% elseif not server %}
            <div class="alert alert-info mb-0" role="alert">{{ 'Your server is still being set up. Check back shortly.'|trans }}</div>
        {% else %}
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">{{ 'Address'|trans }}</dt>
                <dd class="col-sm-9">
                    {% if server.address %}
                        <span class="font-monospace">{{ server.address }}</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary py-0 ms-2" data-calagopus-copy="{{ server.address }}">{{ 'Copy'|trans }}</button>
                    {% else %}
                        <span class="text-muted">{{ 'No address assigned'|trans }}</span>
                    {% endif %}
                </dd>

                {% if server.location %}
                    <dt class="col-sm-3 text-muted">{{ 'Location'|trans }}</dt>
                    <dd class="col-sm-9">{{ server.location }}</dd>
                {% endif %}

                {% if server.uptime %}
                    <dt class="col-sm-3 text-muted">{{ 'Uptime'|trans }}</dt>
                    <dd class="col-sm-9">{{ server.uptime }}</dd>
                {% endif %}

                {% for key, label in { 'memory': 'Memory'|trans, 'disk': 'Disk'|trans, 'cpu': 'CPU'|trans } %}
                    {% set resource = server.resources[key] %}
                    <dt class="col-sm-3 text-muted">{{ label }}</dt>
                    <dd class="col-sm-9">
                        {% if resource.used is not null %}{{ resource.used }} / {% endif %}{{ resource.limit }}
                        {% if resource.percent is not null %}
                            <div class="progress mt-1" style="height: 6px; max-width: 320px;" role="progressbar" aria-label="{{ label }}" aria-valuenow="{{ resource.percent }}" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar{% if resource.percent >= 90 %} bg-danger{% elseif resource.percent >= 75 %} bg-warning{% endif %}" style="width: {{ resource.percent }}%"></div>
                            </div>
                        {% endif %}
                    </dd>
                {% endfor %}

                <dt class="col-sm-3 text-muted">{{ 'Includes'|trans }}</dt>
                <dd class="col-sm-9 mb-0">
                    {% for include in server.includes %}
                        <span class="text-nowrap">{{ include.label }} <strong>{{ include.value }}</strong>{% if not loop.last %}<span class="text-muted"> &middot; </span>{% endif %}</span>
                    {% endfor %}
                </dd>
            </dl>

            <script>
                document.querySelectorAll('[data-calagopus-copy]').forEach(function (button) {
                    button.addEventListener('click', function () {
                        navigator.clipboard.writeText(button.dataset.calagopusCopy).then(function () {
                            button.textContent = {{ 'Copied'|trans|json_encode|raw }};
                            setTimeout(function () {
                                button.textContent = {{ 'Copy'|trans|json_encode|raw }};
                            }, 2000);
                        });
                    });
                });
            </script>
        {% endif %}
    </div>
</div>
{% endif %}
